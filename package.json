{
  "name": "clifacet-dev",
  "private": true,
  "version": "0.1.0",
  "description": "Developer tooling for the Clifacet workspace",
  "packageManager": "bun@1.4.2",
  "devDependencies": {
    "@eugeniughelbur/agents-md": "0.1.0",
    "backlog.md": "1.53.0",
    "markdownlint-cli2": "0.18.1",
    "readme-md-generator": "1.0.0",
    "skills": "1.7.4"
  },
  "scripts": {
    "agents-md": "agents-md",
    "readme": "readme-md-generator",
    "test": "pixi run --frozen --no-install tools run test",
    "lint": "pixi run --frozen --no-install tools run check",
    "format": "pixi run --frozen --no-install tools run rust.fmt"
  },
  "tasknest": {
    "tasks": {
      "agents-md": {
        "description": "Refresh generated regions of AGENTS.md with agents-md.",
        "marks": [
          "writes",
          "offline"
        ],
        "requires": [
          "bun"
        ]
      },
      "readme": {
        "description": "Render project README from template.",
        "marks": [
          "docs"
        ],
        "requires": [
          "bun"
        ]
      },
      "test": {
        "description": "Run automation test suite via Pixi.",
        "marks": [
          "ci",
          "offline"
        ],
        "requires": [
          "pixi"
        ]
      },
      "lint": {
        "description": "Run automation quality gates via Pixi.",
        "marks": [
          "ci",
          "offline"
        ],
        "requires": [
          "pixi"
        ]
      },
      "format": {
        "description": "Format codebase via Pixi automation.",
        "marks": [
          "writes",
          "offline"
        ],
        "requires": [
          "pixi"
        ]
      }
    }
  }
}
