{
  "$schema": "https://raw.githubusercontent.com/devcontainers/spec/main/schemas/devContainer.schema.json",
  "name": "clifacet",
  "image": "ghcr.io/prefix-dev/pixi:0.83.0@sha256:3dce86c6e87371c58035aa41b09f2b56ca8f011722320551e0c2bfc1c59da5fb",
  "remoteUser": "root",
  "containerEnv": {
    "HOME": "/root",
    "BUN_INSTALL": "/root/.bun",
    "CLIFACET_INSTALL_OPENCODE": "${localEnv:CLIFACET_INSTALL_OPENCODE}"
  },
  "remoteEnv": {
    "PATH": "${containerEnv:PATH}:/root/.bun/bin"
  },
  "postCreateCommand": "bash .devcontainer/setup.sh"
}
